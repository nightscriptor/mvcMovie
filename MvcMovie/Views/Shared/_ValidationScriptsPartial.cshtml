<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>

<script>
    if ($.validator && $.validator.methods) {
        // 1. Allow both commas and dots to be submitted
        $.validator.methods.number = function (value, element) {
            return this.optional(element) || /^-?(?:\d+|\d{1,3}(?:[\s.,]\d{3})+)(?:[\s.,]\d+)?$/.test(value);
        };

        // 2. Fix the range logic to read commas properly
        $.validator.methods.range = function (value, element, param) {
            // Replace comma with dot so JavaScript can evaluate the mathematical min/max correctly
            var globalizedValue = value.replace(",", ".");
            return this.optional(element) || (globalizedValue >= param[0] && globalizedValue <= param[1]);
        };
    }
</script>
